    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zustand": "^4.4.0"
